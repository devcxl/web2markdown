    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/turndown": "5.0.6",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "wxt": "0.20.26"
  }
}
